# Copie para .env e ajuste apenas para o ambiente local.
# Não versione .env nem use credenciais reais neste arquivo.
JOGA_ENVIRONMENT=local
JOGA_DATABASE_URL=postgresql+psycopg://joga:joga@127.0.0.1:5434/joga
JOGA_DATABASE_CONNECT_TIMEOUT_SECONDS=3
JOGA_LOG_LEVEL=INFO

# Placeholder de desenvolvimento. Fora do ambiente local, defina um segredo real
# (por exemplo, via secret manager) e nunca versione o valor.
JOGA_PHONE_HASH_SECRET=local-development-only-change-me
JOGA_OTP_TTL_SECONDS=300
JOGA_OTP_MAX_ATTEMPTS=5
JOGA_OTP_RESEND_COOLDOWN_SECONDS=60
JOGA_OTP_MAX_PER_HOUR=5
JOGA_OTP_MAX_PER_IP_PER_HOUR=20
JOGA_OTP_RECEIPT_TTL_SECONDS=600

# Placeholder de desenvolvimento para hash de access/refresh tokens.
JOGA_TOKEN_HASH_SECRET=local-token-development-only-change-me
JOGA_ACCESS_TOKEN_TTL_SECONDS=600
JOGA_REFRESH_ABSOLUTE_TTL_DAYS=30
JOGA_REFRESH_IDLE_TTL_DAYS=7

# WebAuthn/passkeys. A origem Android abaixo é a do certificado de debug da prova.
JOGA_WEBAUTHN_RP_ID=joga-passkeys.vercel.app
JOGA_WEBAUTHN_RP_NAME=JOGA
JOGA_WEBAUTHN_ORIGIN_ANDROID=android:apk-key-hash:-sYXRdwJA3hvue3mKpYrOZ9zSPC7b4mbgzJmdZEDO5w
JOGA_WEBAUTHN_ORIGIN_WEB=https://joga-passkeys.vercel.app
JOGA_PASSKEY_CHALLENGE_TTL_SECONDS=300
JOGA_PASSKEY_MAX_PER_IP_PER_HOUR=30

# Apenas desenvolvimento local: fixa o OTP para testes no app. Deixe desativado
# em qualquer ambiente compartilhado; o backend rejeita fora de local/test/dev.
# JOGA_DEV_FIXED_OTP=123456
