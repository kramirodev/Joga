# Copie para .env e ajuste apenas para o ambiente local.
# Não versione .env nem use credenciais reais neste arquivo.
JOGA_ENVIRONMENT=local
JOGA_DATABASE_URL=postgresql+psycopg://joga:joga@127.0.0.1:5434/joga
JOGA_DATABASE_CONNECT_TIMEOUT_SECONDS=3
JOGA_MAX_REQUEST_BODY_BYTES=1000000
JOGA_LOG_LEVEL=INFO

# Hosts extras aceitos no header Host, separados por virgula. localhost,
# 127.0.0.1, testserver e RENDER_EXTERNAL_HOSTNAME sao aceitos automaticamente.
# Nao use curinga, esquema nem porta.
JOGA_TRUSTED_HOSTS=

# Gate de versão mínima do app mobile (ADR 0051). Desativado em local/teste.
# O app envia X-Client: mobile e X-App-Version: MAJOR.MINOR.PATCH. Sem X-Client,
# User-Agent OkHttp/CFNetwork/Expo é tratado como app antigo. O painel envia
# X-Client: web e não é bloqueado. Ativar no demo/produção quando houver build
# nova distribuída.
JOGA_APP_VERSION_GATE_ENABLED=false
JOGA_MIN_APP_VERSION=1.0.1
JOGA_LATEST_APP_VERSION=1.0.1
# JOGA_APP_UPDATE_URL=https://...

# Placeholder de desenvolvimento. Fora do ambiente local, defina um segredo real
# (por exemplo, via secret manager) e nunca versione o valor.
JOGA_PHONE_HASH_SECRET=local-development-only-change-me
JOGA_OTP_TTL_SECONDS=300
JOGA_OTP_MAX_ATTEMPTS=5
JOGA_OTP_RESEND_COOLDOWN_SECONDS=60
JOGA_OTP_MAX_PER_HOUR=5
JOGA_OTP_MAX_PER_IP_PER_HOUR=20
JOGA_OTP_RECEIPT_TTL_SECONDS=600

# Perfil BETA da credencial de login (ADR 0050). Login e E-MAIL + SENHA;
# o codigo de 6 digitos serve apenas para verificar o e-mail no cadastro,
# trocar o e-mail e redefinir a senha. O telefone fica dormente por flag; no
# lancamento, troque AUTH_PHONE_ENABLED=true, ALLOW_PHONE_REGISTRATION=true e
# PHONE_REQUIRED_FOR_BOOKING=true. Nunca habilite e-mail sem provedor.
JOGA_AUTH_EMAIL_ENABLED=true
JOGA_AUTH_PHONE_ENABLED=false
JOGA_ALLOW_EMAIL_REGISTRATION=true
JOGA_ALLOW_PHONE_REGISTRATION=false
JOGA_PHONE_REQUIRED_FOR_BOOKING=false
JOGA_SIGNUP_MODE=open
# Login por senha: 10 tentativas/15 min por e-mail e 30/15 min por IP.
JOGA_EMAIL_LOGIN_MAX_PER_EMAIL=10
JOGA_EMAIL_LOGIN_MAX_PER_IP=30

# E-mail transacional. Brevo free = 300/dia; o orcamento precisa ficar abaixo.
# Use provider=fake apenas em local/teste. Para envio real, troque para brevo
# (ou resend com dominio verificado) e defina a API key via variavel de ambiente.
# Nunca versione a API key real.
JOGA_EMAIL_PROVIDER=fake
# JOGA_EMAIL_PROVIDER=brevo
# JOGA_EMAIL_API_KEY=...
# JOGA_EMAIL_FROM=no-reply@seudominio-verificado.example
JOGA_EMAIL_FROM_NAME=JOGA
# JOGA_EMAIL_REPLY_TO=suporte@seudominio-verificado.example
JOGA_EMAIL_TIMEOUT_SECONDS=10
JOGA_EMAIL_DAILY_BUDGET=250
JOGA_EMAIL_CODE_TTL_SECONDS=600
JOGA_EMAIL_MAX_PER_ADDRESS_PER_HOUR=5
JOGA_EMAIL_MAX_PER_IP_PER_HOUR=50
JOGA_EMAIL_RESEND_COOLDOWN_SECONDS=60
JOGA_SIGNUP_MAX_PER_IP_PER_DAY=20
JOGA_EMAIL_MAX_DELIVERY_ATTEMPTS=5
JOGA_EMAIL_BOUNCE_THRESHOLD=3
JOGA_EMAIL_CHANGE_COOLDOWN_HOURS=24
# Drenagem da Outbox no processo da API (demo no Render free). Desligada por
# padrão; em test o ciclo não sobe. Intervalo entre 10 e 300 segundos.
# O workflow agendado do GitHub continua como caminho de reserva.
JOGA_EMAIL_INLINE_DRAIN_ENABLED=false
JOGA_EMAIL_INLINE_DRAIN_INTERVAL_SECONDS=30
# Lista adicional de dominios descartaveis, separada por virgula.
JOGA_EMAIL_DISPOSABLE_DOMAINS=

# Placeholder de desenvolvimento para hash de access/refresh tokens.
JOGA_TOKEN_HASH_SECRET=local-token-development-only-change-me
JOGA_ACCESS_TOKEN_TTL_SECONDS=600
JOGA_REFRESH_ABSOLUTE_TTL_DAYS=180
JOGA_REFRESH_IDLE_TTL_DAYS=30
# Janela de tolerância para corrida legítima no refresh (duas chamadas
# concorrentes com o mesmo token). Dentro dela, reutilizar o token imediatamente
# anterior não revoga a família: a resposta é 401 refresh_retry_required e o
# cliente deve repetir com o par mais novo. 0 desliga; máximo 300 segundos.
JOGA_REFRESH_REUSE_GRACE_SECONDS=30
# Apenas para ambiente local (HTTP). Fora de local/test/ci/development o
# boot exige JOGA_WEB_COOKIE_SECURE=true.
JOGA_WEB_COOKIE_SECURE=false

# WebAuthn/passkeys. A origem Android abaixo é a do certificado de debug da prova.
JOGA_WEBAUTHN_RP_ID=joga-passkeys.vercel.app
JOGA_WEBAUTHN_RP_NAME=JOGA
JOGA_WEBAUTHN_ORIGIN_ANDROID=android:apk-key-hash:-sYXRdwJA3hvue3mKpYrOZ9zSPC7b4mbgzJmdZEDO5w
JOGA_WEBAUTHN_ORIGIN_WEB=https://joga-passkeys.vercel.app
JOGA_PASSKEY_CHALLENGE_TTL_SECONDS=300
JOGA_PASSKEY_MAX_PER_IP_PER_HOUR=30

# Apenas desenvolvimento local: fixa o OTP para testes no app. Deixe desativado
# em qualquer ambiente compartilhado; o backend rejeita fora de local/test/dev.
# JOGA_DEV_FIXED_OTP=123456

# Perfil e descoberta (Fase 4)
JOGA_CEP_API_BASE_URL=https://brasilapi.com.br/api/cep/v2
JOGA_CEP_TIMEOUT_SECONDS=5
# Verificação automática de CNPJ de organizações (ADR 0062). Falha fechada:
# provedor indisponível não aprova o cadastro. A reverificação roda em lote por
# JOGA_ORGANIZATION_CNPJ_RECHECK_DAYS, contados do cadastro de cada organização.
JOGA_CNPJ_API_BASE_URL=https://brasilapi.com.br/api/cnpj/v1
JOGA_CNPJ_TIMEOUT_SECONDS=5
JOGA_CNPJ_LOOKUP_ATTEMPTS=2
JOGA_CNPJ_CACHE_TTL_SECONDS=300
JOGA_ORGANIZATION_CNPJ_RECHECK_DAYS=7
JOGA_ORGANIZATION_CNPJ_RETRY_HOURS=6
JOGA_GEO_TIMEOUT_SECONDS=3
JOGA_GEO_CACHE_TTL_DAYS=30
JOGA_GEO_RATE_LIMIT_PER_MINUTE=30
JOGA_GEO_PROVIDER_VERSION=brasilapi_v1
JOGA_DISCOVERY_MAX_RADIUS_KM=100
JOGA_DISCOVERY_DEFAULT_RADIUS_KM=10
JOGA_DISCOVERY_PAGE_SIZE=20
JOGA_LOCATION_ROUND_DECIMALS=2
JOGA_DEFAULT_TIMEZONE=America/Sao_Paulo

# Matchmaking (Fase 5)
JOGA_MATCHMAKING_ALGORITHM_VERSION=level_v1
JOGA_MATCHMAKING_QUEUE_TTL_HOURS=24
JOGA_MATCHMAKING_SEARCH_DAYS=7
JOGA_MATCHMAKING_SLOT_MINUTES=30
JOGA_MATCHMAKING_MIN_LEAD_MINUTES=120
JOGA_MATCHMAKING_MAX_RADIUS_KM=30

# Fotos de quadra (Fase 12A). Storage local privado; não é servido estaticamente.
JOGA_MEDIA_ROOT=var/media
JOGA_VENUE_PHOTO_MAX_BYTES=5000000
JOGA_VENUE_PHOTO_MAX_PIXELS=40000000
JOGA_VENUE_PHOTO_MAX_DIMENSION=4000
JOGA_VENUE_PHOTO_MIN_DIMENSION=200
JOGA_VENUE_PHOTO_OUTPUT_MAX_DIMENSION=2000

# Reservas e temporizadores (Fase 13A)
JOGA_BOOKING_T1_MINUTES=60
JOGA_BOOKING_T2_MINUTES=30
JOGA_BOOKING_T2_MAX_MINUTES=60
JOGA_BOOKING_T3_MINUTES=60
JOGA_BOOKING_PAYMENT_BUFFER_MINUTES=10
# ADR 0039: cutoff e janela de substituição (propostas iniciais)
JOGA_CANCELLATION_CUTOFF_HOURS=6
JOGA_SUBSTITUTION_WINDOW_PERCENT=25
JOGA_SUBSTITUTION_WINDOW_MIN_MINUTES=30
JOGA_SUBSTITUTION_WINDOW_MAX_HOURS=12
JOGA_LATE_SUBSTITUTION_WINDOW_MINUTES=15
JOGA_SUBSTITUTION_CALL_TIMEOUT_MINUTES=5
JOGA_PRESENCE_OPEN_LEAD_MINUTES=60
JOGA_PRESENCE_CLOSE_LEAD_MINUTES=30
JOGA_PRESENCE_RADIUS_M=200
JOGA_PRESENCE_MAX_ACCURACY_M=100

# PSP. O simulador é o padrão local/CI. Fora de local/teste/demo, o Mercado
# Pago é obrigatório com credenciais do ambiente e webhook HTTPS. O e-mail do
# pagador vem de GET/PUT /me/email, não de variável global.
JOGA_PSP_PROVIDER=simulator
# JOGA_MERCADO_PAGO_ACCESS_TOKEN=...
# JOGA_MERCADO_PAGO_WEBHOOK_SECRET=...
JOGA_MERCADO_PAGO_BASE_URL=https://api.mercadopago.com
# A Orders API não aceita notification_url no payload; configure esta URL no
# painel de Webhooks do Mercado Pago. A variável fica como referência operacional.
# JOGA_MERCADO_PAGO_NOTIFICATION_URL=https://seu-dominio/api/v1/payments/mercadopago/webhook
JOGA_PSP_TIMEOUT_SECONDS=10

# Perfil demo (JOGA_ENVIRONMENT=demo): demonstração privada, sem PSP real e
# sem dinheiro real. O boot exige simulador, money simulated, tickets
# desligados, segredos não-default e CPF; NÃO exige JOGA_MERCADO_PAGO_*.
# O webhook do Mercado Pago responde 404 webhook_disabled e não grava evento.
# Copie este bloco para o ambiente do demo e defina os segredos fora do Git.
# JOGA_ENVIRONMENT=demo
# JOGA_PSP_PROVIDER=simulator
# JOGA_MONEY_MODE=simulated
# JOGA_TICKET_PURCHASE_ENABLED=false
# JOGA_PHONE_HASH_SECRET=<segredo próprio do demo>
# JOGA_TOKEN_HASH_SECRET=<segredo próprio do demo>
# JOGA_CPF_KEY=<32 bytes em base64>
# JOGA_CPF_KEY_ID=demo-v1
# Nunca use JOGA_DEV_FIXED_OTP no demo (o boot recusa).

# ADR 0049 — modelo tributário e custódia. Tudo em simulated/disabled/B por
# padrão. `real` só sobe com a referência, o hash e a data do parecer; `C` e
# `provider` falham no boot enquanto não houver implementação.
JOGA_MONEY_MODE=simulated
JOGA_CUSTODY_MODEL=B
JOGA_FISCAL_MODE=disabled
# JOGA_LEGAL_APPROVAL_REF=parecer-fiscal-juridico-YYYY-MM
# JOGA_LEGAL_APPROVAL_SHA256=<64 hex do PDF>
# JOGA_LEGAL_APPROVAL_DATE=YYYY-MM-DD
JOGA_TAX_RATE_BPS=1550
JOGA_FEE_PERCENT_BPS=2000
JOGA_FEE_MIN_CENTS=800
JOGA_CANCELLATION_PROVISION_CENTS=20
JOGA_PAYOUT_REQUIRES_FISCAL_DOCUMENT=true
JOGA_FISCAL_DOCUMENT_GRACE_DAYS=5
JOGA_VENUE_RECEIVABLE_OFFSET_DAYS=90
JOGA_CREDIT_REFUND_DAYS=30
# CPF cifrado (AES-256-GCM). Nunca versione a chave; use secret manager fora do local.
# Obrigatório fora do ambiente local desde a Etapa 14E-E (inclusive no demo): sem
# chave, o boot falha.
# AAD é o user_id e o ciphertext é nonce(12)||ciphertext||tag(16).
# JOGA_CPF_KEY=<32 bytes em base64>
# JOGA_CPF_KEY_ID=local-v1
# Rotação: mova a chave antiga para JOGA_CPF_PREVIOUS_KEYS e mantenha-a só para
# leitura até a recifragem terminar. Formato JSON: {"local-v0": "<base64>"}.
# JOGA_CPF_PREVIOUS_KEYS={}
# A unicidade por conta usa HMAC-SHA256 do CPF com JOGA_PHONE_HASH_SECRET e o
# rótulo "cpf:" (ADR 0065). Não há segredo novo; o hash nunca sai em resposta.

# Push: webhook operacional opcional. A central de notificações é a fonte de
# verdade; sem URL configurada, os eventos permanecem pendentes na Outbox.
# JOGA_PUSH_WEBHOOK_URL=https://seu-worker/push
JOGA_PUSH_TIMEOUT_SECONDS=5

# Liberação ao estabelecimento: 2 h após o início da partida (ADR 0040).
JOGA_RELEASE_DELAY_HOURS=2

# Janela de contestação contada de eligible_at (starts_at + 2 h). Decisão de
# 17/11/2026: 72 h, persistida como snapshot na liberação e na contestação.
JOGA_DISPUTE_WINDOW_HOURS=72

# Revisão humana de resultados (Fase 7) e de contestações financeiras (Fase 15).
# Lista separada por vírgula. Vazio significa que nenhum operador está
# autorizado; nunca use em produção sem definir operadores reais via secret
# manager.
JOGA_REVIEW_OPERATORS=

# Limite de POSTs de resultado por usuário em uma janela de 60 segundos.
JOGA_RESULTS_RATE_LIMIT_PER_MINUTE=30

# Moderação (Fase 17A). Lista separada por vírgula de nomes internos autorizados.
# Vazio significa que nenhum operador pode decidir.
JOGA_MODERATION_OPERATORS=
JOGA_MODERATION_ADMIN_USER_IDS=
JOGA_MODERATION_MAX_REPORTS_PER_DAY=5
JOGA_MODERATION_FALSE_REPORT_THRESHOLD=3
JOGA_MODERATION_FALSE_REPORT_COOLDOWN_DAYS=7
JOGA_MODERATION_RETENTION_DAYS=180

# Administração de plataforma (catálogo de esportes e usuários). Lista de user
# IDs separada por vírgula. Vazio significa que ninguém tem platform.admin.
JOGA_PLATFORM_ADMINS=

# Organização da plataforma que possui as quadras públicas. O seed da migração
# usa este slug e a organização não aparece em listagens de estabelecimentos.
JOGA_PLATFORM_ORG_SLUG=joga-publico

# Compra de tickets. Desligada por padrão; ligue apenas com decisão operacional
# e PSP validado.
JOGA_TICKET_PURCHASE_ENABLED=false
