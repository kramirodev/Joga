# Copie para .env e ajuste apenas para o ambiente local.
# Não versione .env nem use credenciais reais neste arquivo.
JOGA_ENVIRONMENT=local
JOGA_DATABASE_URL=postgresql+psycopg://joga:joga@127.0.0.1:5434/joga
JOGA_DATABASE_CONNECT_TIMEOUT_SECONDS=3
JOGA_MAX_REQUEST_BODY_BYTES=1000000
JOGA_LOG_LEVEL=INFO

# Placeholder de desenvolvimento. Fora do ambiente local, defina um segredo real
# (por exemplo, via secret manager) e nunca versione o valor.
JOGA_PHONE_HASH_SECRET=local-development-only-change-me
JOGA_OTP_TTL_SECONDS=300
JOGA_OTP_MAX_ATTEMPTS=5
JOGA_OTP_RESEND_COOLDOWN_SECONDS=60
JOGA_OTP_MAX_PER_HOUR=5
JOGA_OTP_MAX_PER_IP_PER_HOUR=20
JOGA_OTP_RECEIPT_TTL_SECONDS=600

# Placeholder de desenvolvimento para hash de access/refresh tokens.
JOGA_TOKEN_HASH_SECRET=local-token-development-only-change-me
JOGA_ACCESS_TOKEN_TTL_SECONDS=600
JOGA_REFRESH_ABSOLUTE_TTL_DAYS=30
JOGA_REFRESH_IDLE_TTL_DAYS=7
JOGA_WEB_COOKIE_SECURE=false

# WebAuthn/passkeys. A origem Android abaixo é a do certificado de debug da prova.
JOGA_WEBAUTHN_RP_ID=joga-passkeys.vercel.app
JOGA_WEBAUTHN_RP_NAME=JOGA
JOGA_WEBAUTHN_ORIGIN_ANDROID=android:apk-key-hash:-sYXRdwJA3hvue3mKpYrOZ9zSPC7b4mbgzJmdZEDO5w
JOGA_WEBAUTHN_ORIGIN_WEB=https://joga-passkeys.vercel.app
JOGA_PASSKEY_CHALLENGE_TTL_SECONDS=300
JOGA_PASSKEY_MAX_PER_IP_PER_HOUR=30

# Apenas desenvolvimento local: fixa o OTP para testes no app. Deixe desativado
# em qualquer ambiente compartilhado; o backend rejeita fora de local/test/dev.
# JOGA_DEV_FIXED_OTP=123456

# Perfil e descoberta (Fase 4)
JOGA_CEP_API_BASE_URL=https://brasilapi.com.br/api/cep/v2
JOGA_CEP_TIMEOUT_SECONDS=5
JOGA_DISCOVERY_MAX_RADIUS_KM=100
JOGA_DISCOVERY_DEFAULT_RADIUS_KM=10
JOGA_DISCOVERY_PAGE_SIZE=20
JOGA_LOCATION_ROUND_DECIMALS=2
JOGA_DEFAULT_TIMEZONE=America/Sao_Paulo

# Matchmaking (Fase 5)
JOGA_MATCHMAKING_ALGORITHM_VERSION=level_v1
JOGA_MATCHMAKING_QUEUE_TTL_HOURS=24
JOGA_MATCHMAKING_SEARCH_DAYS=7
JOGA_MATCHMAKING_SLOT_MINUTES=30
JOGA_MATCHMAKING_MIN_LEAD_MINUTES=120
JOGA_MATCHMAKING_MAX_RADIUS_KM=30

# Fotos de quadra (Fase 12A). Storage local privado; não é servido estaticamente.
JOGA_MEDIA_ROOT=var/media
JOGA_VENUE_PHOTO_MAX_BYTES=5000000
JOGA_VENUE_PHOTO_MAX_PIXELS=40000000
JOGA_VENUE_PHOTO_MAX_DIMENSION=4000
JOGA_VENUE_PHOTO_MIN_DIMENSION=200
JOGA_VENUE_PHOTO_OUTPUT_MAX_DIMENSION=2000

# Reservas e temporizadores (Fase 13A)
JOGA_BOOKING_T1_MINUTES=60
JOGA_BOOKING_T2_MINUTES=30
JOGA_BOOKING_T2_MAX_MINUTES=60
JOGA_BOOKING_T3_MINUTES=60
JOGA_BOOKING_PAYMENT_BUFFER_MINUTES=10
# ADR 0039: cutoff e janela de substituição (propostas iniciais)
JOGA_CANCELLATION_CUTOFF_HOURS=6
JOGA_SUBSTITUTION_WINDOW_PERCENT=25
JOGA_SUBSTITUTION_WINDOW_MIN_MINUTES=30
JOGA_SUBSTITUTION_WINDOW_MAX_HOURS=12
JOGA_LATE_SUBSTITUTION_WINDOW_MINUTES=15
JOGA_SUBSTITUTION_CALL_TIMEOUT_MINUTES=5
JOGA_PRESENCE_OPEN_LEAD_MINUTES=60
JOGA_PRESENCE_CLOSE_LEAD_MINUTES=30
JOGA_PRESENCE_RADIUS_M=200
JOGA_PRESENCE_MAX_ACCURACY_M=100

# PSP (Fase 14A). Use simulator no local/CI. Mercado Pago apenas sandbox/beta,
# sem dinheiro real. Nunca versione credenciais reais.
JOGA_PSP_PROVIDER=simulator
# JOGA_MERCADO_PAGO_ACCESS_TOKEN=TEST-...
# JOGA_MERCADO_PAGO_WEBHOOK_SECRET=...
JOGA_MERCADO_PAGO_BASE_URL=https://api.mercadopago.com
JOGA_MERCADO_PAGO_PAYER_EMAIL=test_user_br@testuser.com
# A Orders API não aceita notification_url no payload; configure esta URL no
# painel de Webhooks do Mercado Pago. A variável fica como referência operacional.
# JOGA_MERCADO_PAGO_NOTIFICATION_URL=https://seu-dominio/api/v1/payments/mercadopago/webhook
JOGA_PSP_TIMEOUT_SECONDS=10

# Liberação ao estabelecimento: 2 h após o início da partida (ADR 0040).
JOGA_RELEASE_DELAY_HOURS=2

# Revisão humana de resultados (Fase 7) e de contestações financeiras (Fase 15).
# Lista separada por vírgula. Vazio significa que nenhum operador está
# autorizado; nunca use em produção sem definir operadores reais via secret
# manager.
JOGA_REVIEW_OPERATORS=

# Limite de POSTs de resultado por usuário em uma janela de 60 segundos.
JOGA_RESULTS_RATE_LIMIT_PER_MINUTE=30
