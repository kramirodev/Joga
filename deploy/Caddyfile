# Uma origem so: API e painel no mesmo host.
#
# /api/*      -> uvicorn em 127.0.0.1:8000, sem basic auth. O app mobile usa a
#                mesma URL e nao envia credencial HTTP; a API tem autenticacao
#                propria (tokens/cookies SameSite=Strict).
# /api/v1/health/* tambem fica aberto: Render e UptimeRobot nao enviam basic
# auth.
# /           -> SPA compilado em /srv/web, protegido por basic auth.
#
# DEMO_BASIC_AUTH_HASH e um hash bcrypt gerado por:
#   caddy hash-password --plaintext '<senha-do-demo>'
# Nunca coloque a senha em claro neste arquivo ou no Git.
#
# IP real do cliente:
# O trafego externo passa pelo Cloudflare e chega ao Render; o peer imediato
# do Caddy e sempre um endereco privado da rede interna. O Cloudflare define
# (e sobrescreve) CF-Connecting-IP. O bloco global abaixo so aceita headers de
# encaminhamento quando o peer imediato e privado, usa CF-Connecting-IP como
# fonte e, com trusted_proxies_strict, considera apenas o primeiro valor dessa
# cadeia. X-Forwarded-For da entrada e ignorado: o cliente pode forjar o
# primeiro valor, entao a cadeia nao deve ser usada sem sanitizacao. Sem esse
# bloco o Caddy usa o IP do peer do Render e todos os clientes caem no mesmo
# balde de rate limit.
{
	servers {
		trusted_proxies static private_ranges
		trusted_proxies_strict
		client_ip_headers CF-Connecting-IP
	}
}

:{$PORT} {
	# TLS termina na borda do Render: o processo recebe HTTP e a borda envia
	# X-Forwarded-Proto. HSTS só sai quando a requisição original foi HTTPS.
	# Um HSTS enviado em HTTP seria ignorado pelo navegador; a condição evita
	# anunciar HTTPS em um host que não o oferece.
	@https header X-Forwarded-Proto https
	header @https {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	# Headers de segurança em todas as respostas (SPA, API e assetlinks).
	# ``?`` só define quando a resposta ainda não trouxe o header: a API já
	# envia nosniff/referrer-policy em todas as respostas, e repetir o valor no
	# proxy criaria headers duplicados. A CSP repete e amplia o <meta> do SPA:
	# adiciona frame-ancestors, que não funciona em meta. O painel não usa
	# câmera, microfone nem geolocalização.
	header {
		?X-Content-Type-Options "nosniff"
		?Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; form-action 'self'; frame-src 'none'; frame-ancestors 'none'; worker-src 'self'; manifest-src 'self'"
	}

	# Android Digital Asset Links: precisa ser aberto e sem basic auth para o
	# Credential Manager verificar o app. Expoe somente este arquivo estatico.
	handle /.well-known/assetlinks.json {
		root * /srv/web
		file_server
	}

	handle /api/* {
		# X-Forwarded-For: reescrito com o IP resolvido pelo bloco global
		# (CF-Connecting-IP), portanto o uvicorn recebe uma cadeia de um unico
		# elemento. Nao usar o primeiro valor do X-Forwarded-For original: ele
		# pode vir forjado. CF-Connecting-IP e True-Client-IP nao seguem para o
		# backend.
		#
		# X-Forwarded-Proto: o Render envia https na borda; o header_up preserva
		# o valor original em vez do esquema interno do proxy. Se o header nao
		# existir (health check interno/direto), o placeholder resolve vazio; o
		# uvicorn ignora o valor vazio e usa http. Sem repassar esse valor, o
		# Location absoluto sairia em http:// atras de HTTPS.
		reverse_proxy 127.0.0.1:8000 {
			header_up X-Forwarded-For {client_ip}
			header_up -CF-Connecting-IP
			header_up -True-Client-IP
			header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
		}
	}

	handle {
		# O nome de usuario e fixo ("demo"); a senha vem apenas do hash bcrypt.
		# A diretiva exige o par <usuario> <hash>; um hash sozinho e invalido.
		basic_auth {
			demo {$DEMO_BASIC_AUTH_HASH}
		}
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
}
